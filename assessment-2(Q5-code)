
import numpy as np

def array_factor(N, angle):
    d = 0.5
    theta = np.radians(angle)
    n = np.arange(N)

    psi = 2 * np.pi * d * np.sin(theta)

    af = np.sum(np.exp(1j * n * psi))
    return abs(af) / N

angles = np.linspace(-90, 90, 18001)

for N in [2, 4, 8, 16]:
    pattern = np.array([array_factor(N, a) for a in angles])

    power = pattern ** 2
    peak = np.argmax(power)

    left = peak
    right = peak

    while left > 0 and power[left] >= 0.5:
        left -= 1

    while right < len(power)-1 and power[right] >= 0.5:
        right += 1

    beamwidth = angles[right] - angles[left]

    side = power.copy()
    side[max(0, left-1):min(len(side), right+2)] = 0

    sidelobe = 10 * np.log10(max(np.max(side), 1e-12))

    print("\nAntenna Elements:", N)
    print("Beamwidth:", round(beamwidth, 2), "degrees")
    print("Sidelobe Level:", round(sidelobe, 2), "dB")

    print("Angular Separation | SIR")

    for separation in range(5, 65, 5):
        af = array_factor(N, separation)
        sir = -20 * np.log10(max(af, 1e-12))

        print(separation, "degrees |", round(sir, 2), "dB")
