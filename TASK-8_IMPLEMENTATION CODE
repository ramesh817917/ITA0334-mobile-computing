
import numpy as np
import math

S = 336
R = 0.5
AREA = 12
SEED = 42

def erlang_b(c, a):
    b = 1.0
    for i in range(1, c + 1):
        b = a * b / (i + a * b)
    return b

def max_traffic(c):
    low, high = 0, c * 2
    for _ in range(60):
        mid = (low + high) / 2
        if erlang_b(c, mid) > 0.02:
            high = mid
        else:
            low = mid
    return low

def hex_grid(rows, cols):
    points = []
    for q in range(cols):
        for r in range(rows):
            x = 1.5 * q
            y = math.sqrt(3) * (r + q / 2)
            points.append((x, y))
    return np.array(points)

def theoretical_sir(N, n, interferers=6):
    return 10 * np.log10((3 * N)**(n / 2) /
                         interferers)

def monte_carlo_sir(N, n, sector=False, samples=5000):
    rng = np.random.default_rng(SEED)

    D = math.sqrt(3 * N)
    angles = np.arange(6) * math.pi / 3
    bs = np.column_stack((D * np.cos(angles),
                          D * np.sin(angles)))

    values = []

    for _ in range(samples):
        while True:
            x, y = rng.uniform(-0.5, 0.5, 2)
            if (abs(x) <= 0.5 and
                abs(y) <= math.sqrt(3) / 2 and
                abs(x) + abs(y) / math.sqrt(3) <= 1):
                break

        desired = (x*x + y*y)**(-n/2)

        distances = np.sqrt(
            np.sum((bs - [x, y])**2, axis=1)
        )

        interference = distances**(-n)

        if sector:
            interference = np.sort(interference)[-2:]

        sir = desired / np.sum(interference)
        values.append(10 * np.log10(sir))

    return np.array(values)

print("HEXAGONAL CELL LOCATIONS")
print(hex_grid(3, 4))

print("\nSTRATEGY COMPARISON")

for N in [3, 4, 7, 12]:
    channels = S // N
    traffic = max_traffic(channels)

    for n in [2.5, 3, 4]:
        fixed = theoretical_sir(N, n, 6)
        sector = theoretical_sir(N, n, 2)

        print("N:", N, "n:", n,
              "Channels:", channels,
              "Fixed SIR:", round(fixed, 2),
              "Sector SIR:", round(sector, 2),
              "Traffic:", round(traffic, 2))

print("\nSUBSCRIBER TESTING")

for users in [1000, 10000, 20000, 100000]:
    demand = users * 0.025
    cells = math.ceil(
        AREA / (3 * math.sqrt(3) / 2 * R**2)
    )

    per_cell = demand / cells
    capacity = max_traffic(48)

    blocking = erlang_b(48, per_cell)

    print("Users:", users,
          "Demand:", demand,
          "Cells:", cells,
          "Blocking:", round(blocking * 100, 2), "%")

print("\nMONTE CARLO SIR")

for sector in [False, True]:
    result = monte_carlo_sir(7, 4, sector)

    print("Sectoring:", sector)
    print("Mean SIR:", round(np.mean(result), 2))
    print("5th percentile:", round(
        np.percentile(result, 5), 2))
    print("Outage:", round(
        np.mean(result < 15) * 100, 2), "%")
